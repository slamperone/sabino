---
import '../styles/styles.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  wfPage?: string;
}

const {
  title = "Puenter Agency",
  description = "We place great emphasis on providing designers, artists, and brands with designs that elevates their visual communication.",
  ogImage = "/img/opengraph.jpg",
  wfPage = "69003b725c09305a7640a56a"
} = Astro.props;
---

<!DOCTYPE html>
<html data-wf-page={wfPage} data-wf-site="69002c5130201afdd240ac96" lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta content={description} name="description" />
  <meta content={title} property="og:title" />
  <meta content={description} property="og:description" />
  <meta content={ogImage} property="og:image" />
  <meta content={title} name="twitter:title" />
  <meta content={description} name="twitter:description" />
  <meta content={ogImage} name="twitter:image" />
  <meta property="og:type" content="website" />
  <meta content="summary_large_image" name="twitter:card" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <meta content="HTML5" name="generator" />

  <link href="/img/favicon.ico" rel="shortcut icon" type="image/x-icon" />
  <link href="/img/puenter-icon.png" rel="apple-touch-icon" />

  <style is:global>
    @media (min-width: 992px) {
      html.w-mod-js:not(.w-mod-ix) [data-w-id="88afed8a-695a-7a94-ed6f-e98a2426d74b"] {
        opacity: 0;
        display: none;
        transform: translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(5deg) skew(0, 0);
      }
      html.w-mod-js:not(.w-mod-ix) [data-w-id="f4878c32-2a69-9269-23b4-c968537d5e1a"] {
        transform: translate3d(0, 10vh, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);
      }
      html.w-mod-js:not(.w-mod-ix) [data-w-id="3091901e-d5f1-c413-7772-82a102cb734d"] {
        opacity: 0;
        display: none;
        transform: translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(5deg) skew(0, 0);
      }
      html.w-mod-js:not(.w-mod-ix) [data-w-id="197a4f05-60c3-3c37-794d-be92196a62de"] {
        transform: translate3d(0, 10vh, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);
      }
      html.w-mod-js:not(.w-mod-ix) [data-w-id="8642c676-9a68-74ee-d568-3f5f7b17d0c5"] {
        opacity: 0;
        display: none;
        transform: translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(5deg) skew(0, 0);
      }
      html.w-mod-js:not(.w-mod-ix) [data-w-id="64ba4078-8171-6438-287e-f055f570b993"] {
        transform: translate3d(0, 10vh, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);
      }
      html.w-mod-js:not(.w-mod-ix) [data-w-id="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd3"] {
        opacity: 0;
        display: none;
        transform: translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(5deg) skew(0, 0);
      }
      html.w-mod-js:not(.w-mod-ix) [data-w-id="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd8"] {
        transform: translate3d(0, 10vh, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);
      }
    }

    /* Hamburger SVG Animation */
    .menu-navbar-button svg path {
      transition: transform 0.3s ease, opacity 0.3s ease;
      transform-origin: 12px 12px;
    }
    .menu-navbar-button.w--open .line-top {
      transform: translateY(6px) rotate(45deg);
    }
    .menu-navbar-button.w--open .line-middle {
      opacity: 0;
    }
    .menu-navbar-button.w--open .line-bottom {
      transform: translateY(-6px) rotate(-45deg);
    }

    @media screen and (max-width: 991px) {
      .w-nav-overlay {
        overflow: visible !important;
      }
      .menu-navbar[data-nav-menu-open] {
        animation: menuRotateIn .6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
        transform-origin: top left;
        backface-visibility: hidden;
      }
      .menu-navbar.menu-closing {
        animation: menuRotateOut .6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards !important;
        transform-origin: top left;
        backface-visibility: hidden;
      }
      .menu-navbar .nav-link .dropdown-navbar,
      .menu-navbar .mobile-navbar-content .link-block-navbar {
        opacity: 0;
      }
      [data-nav-menu-open] .nav-link .dropdown-navbar,
      [data-nav-menu-open] .mobile-navbar-content .link-block-navbar {
        animation: menuItemsFadeIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      }
      .menu-navbar.menu-closing .nav-link .dropdown-navbar,
      .menu-navbar.menu-closing .mobile-navbar-content .link-block-navbar {
        opacity: 0 !important;
        transform: translateY(200px) scale(0.15) rotate(-20deg) !important;
        transition: opacity 0.2s ease, transform 0.2s ease !important;
      }
      [data-nav-menu-open] .nav-link:nth-child(1) .dropdown-navbar { animation-delay: 0.68s; }
      [data-nav-menu-open] .nav-link:nth-child(2) .dropdown-navbar { animation-delay: 0.74s; }
      [data-nav-menu-open] .nav-link:nth-child(3) .dropdown-navbar { animation-delay: 0.8s; }
      [data-nav-menu-open] .nav-link:nth-child(4) .dropdown-navbar { animation-delay: 0.86s; }
      [data-nav-menu-open] .mobile-navbar-content .link-block-navbar:nth-child(1) { animation-delay: 0.92s; }
      [data-nav-menu-open] .mobile-navbar-content .link-block-navbar:nth-child(2) { animation-delay: 0.98s; }
    }

    @keyframes menuRotateIn {
      0% {
        transform: rotate(-180deg) scale(0.5);
        border-bottom-left-radius: 700%;
        border-bottom-right-radius: 0px;
        border-top-left-radius: 0px;
        border-top-right-radius: 0px;
      }
      100% {
        transform: rotate(0deg) scale(1);
        border-bottom-left-radius: 0px;
        border-bottom-right-radius: 0px;
        border-top-left-radius: 0px;
        border-top-right-radius: 0px;
      }
    }

    @keyframes menuRotateOut {
      0% {
        transform: rotate(0deg) scale(1);
        border-bottom-left-radius: 0px;
        border-bottom-right-radius: 0px;
        border-top-left-radius: 0px;
        border-top-right-radius: 0px;
      }
      100% {
        transform: rotate(-180deg) scale(0.5);
        border-bottom-left-radius: 700%;
        border-bottom-right-radius: 0px;
        border-top-left-radius: 0px;
        border-top-right-radius: 0px;
      }
    }

    @keyframes menuItemsFadeIn {
      0% {
        opacity: 0;
        transform: translateY(200px) scale(0.15) rotate(-20deg);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1) rotate(0deg);
      }
    }
  </style>

  <script is:inline src="https://use.typekit.net/aps1zie.js" type="text/javascript"></script>
  <script is:inline type="text/javascript">
    try { Typekit.load(); } catch (e) { }
  </script>
  <script is:inline type="text/javascript">
    !function(o,c){
      var n=c.documentElement,t=" w-mod-";
      n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")
    }(window,document);
  </script>
</head>

<body>
  <Navbar />

  <main>
    <slot />
  </main>

  <Footer />

  <script is:inline src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=69002c5130201afdd240ac96" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script is:inline src="/js/app.chunk.1.js" type="text/javascript"></script>
  <script is:inline src="/js/app.chunk.2.js" type="text/javascript"></script>
  <script is:inline src="/js/app.main.js" type="text/javascript"></script>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      var menuBtn = document.querySelector(".menu-navbar-button");
      var menuNav = document.querySelector(".menu-navbar");
      if (menuBtn && menuNav) {
        menuBtn.addEventListener("click", function (e) {
          if (menuBtn.classList.contains("w--open") && !menuNav.classList.contains("menu-closing")) {
            e.preventDefault();
            e.stopImmediatePropagation();
            menuNav.classList.add("menu-closing");
            setTimeout(function () {
              menuNav.classList.remove("menu-closing");
              menuBtn.classList.remove("w--open");
              menuBtn.click();
            }, 600);
          }
        }, true);
      }
    });
  </script>
</body>
</html>
