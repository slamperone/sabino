---
// src/components/BottomNavbar.astro
---
<div class="bottom-navbar-sticky">
  <div class="bottom-navbar">
    <div class="bottom-nav-first-content">
      <div class="bottom-nav-dropdown">
        <div data-hover="true" data-delay="250" data-w-id="c7285266-cac2-5b2a-fb49-d7a77c50dfe9" class="dropdown-mobile w-dropdown">
          <div class="bottom-navbar-icon-wrapper w-dropdown-toggle">
            <img src="/img/bottom-icon.svg" loading="lazy" alt="Icon" class="bottom-icon" />
          </div>
          <nav class="dropdown-bottom-nav w-dropdown-list">
            <div class="dropdown-bottom-nav wrapper">
              <div class="projects-wrapper">
                <div class="opacity-60">
                  <div class="text-size-small caps text-weight-bold">Web Projects</div>
                </div>
                <div class="card-elipse"></div>
              </div>
              <div class="collection-list-wrapper-nav w-dyn-list">
                <div role="list" class="collection-list w-dyn-items">
                  <div role="listitem" class="w-dyn-item">
                    <a href="/works/steeeezy" class="dropdown-link w-inline-block">
                      <div class="dropdown-image">
                        <img src="/img/steeeezy/steeeezy-hero.jpg" loading="lazy" alt="Steeeezy" class="image" />
                      </div>
                      <div class="nav-category-link">
                        <div class="text-size-small caps text-weight-bold">Steeeezy</div>
                        <div class="opacity-70">
                          <div class="text-size-small _1">An iconic project meticulously curated by us.</div>
                        </div>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
              <div class="cards-bg"></div>
            </div>
            <div class="polygon">
              <img src="/img/polygon-1.svg" loading="lazy" alt="Polygon" />
            </div>
          </nav>
        </div>

        <div data-hover="true" data-delay="250" data-w-id="89dafa07-639e-df47-380d-8fc4ae8092c2" class="dropdown-mobile w-dropdown">
          <div class="bottom-navbar-icon-wrapper w-dropdown-toggle">
            <img src="/img/bottom-navbar-icon-03.svg" loading="lazy" alt="Icon" class="bottom-icon" />
          </div>
          <nav class="dropdown-bottom-nav w-dropdown-list">
            <div class="dropdown-bottom-nav wrapper">
              <div class="projects-wrapper">
                <div class="opacity-60">
                  <div class="text-size-small caps text-weight-bold">Featured Works</div>
                </div>
                <div class="card-elipse"></div>
              </div>
              <div class="collection-list-wrapper-nav w-dyn-list">
                <div role="list" class="collection-list w-dyn-items">
                  <div role="listitem" class="w-dyn-item">
                    <a href="/works/steeeezy" class="dropdown-link w-inline-block">
                      <div class="dropdown-image">
                        <img src="/img/steeeezy/steeeezy-hero.jpg" loading="lazy" alt="Steeeezy" class="image" />
                      </div>
                      <div class="nav-category-link">
                        <div class="text-size-small caps text-weight-bold">Steeeezy</div>
                        <div class="opacity-70">
                          <div class="text-size-small">Brand Identity & Digital</div>
                        </div>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
              <div class="cards-bg"></div>
            </div>
            <div class="polygon">
              <img src="/img/polygon-1.svg" loading="lazy" alt="Polygon" />
            </div>
          </nav>
        </div>
      </div>
    </div>
    <div class="bottom-nav-links">
      <a href="/" class="bottom-navbar-link w-inline-block">
        <div>Home</div>
      </a>
      <a href="/#services" class="bottom-navbar-link w-inline-block">
        <div>Services</div>
      </a>
      <a href="/#works" class="bottom-navbar-link w-inline-block">
        <div>Works</div>
      </a>
      <a
        href="/#contact"
        data-w-id="6ef0ef42-a06d-2248-b427-b46be2139eac"
        class="main-button-navbar button-hero mobile w-inline-block"
      >
        <div class="relative">
          <div class="text-weight-medium">Contact Us</div>
        </div>
        <div class="button-mask-pricing white"></div>
      </a>
    </div>
  </div>
</div>
