---
// src/components/Navbar.astro
---
<div class="relative">
  <div data-animation="none" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease"
    role="banner" class="navbar w-nav">
    <div class="padding-global">
      <div class="container w-container">
        <div class="component-navbar">
          <a href="/" class="logo-navbar color-black w-nav-brand" aria-label="Puenter Agency Home">
            <div class="w-embed">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 119 119" preserveAspectRatio="xMidYMid meet"
                style="display:block;width:42px;height:auto" role="img" aria-label="Logo">
                <g>
                  <path fill="currentColor"
                    d="M59.5,0C26.64,0,0,26.64,0,59.5s26.64,59.5,59.5,59.5c32.86,0,59.5-26.64,59.5-59.5S92.36,0,59.5,0ZM85.35,49.49c-3.03,12.71-11.43,23.86-22.64,30.01-.77.42-2.6,1.43-4.47,1.43-.91,0-1.82-.24-2.62-.9-2.42-1.99-1.26-5.67-.87-6.88,2.72-8.58,8.57-16.39,16.47-21.99,2.96-2.1,6.07-3.89,9.28-5.46.5-3.45.5-8.59-2.72-12.65-1.99-2.51-7.02-2.99-13.8-1.32-4.81,14.4-10.46,28.57-15.97,42.38-3.65,9.13-7.42,18.58-10.79,27.73l-5.16-1.9c3.4-9.23,7.18-18.71,10.84-27.87,5-12.52,10.1-25.34,14.57-38.31-10.53,3.99-20.02,11.1-26.65,20.14l-4.43-3.25c8.11-11.05,20.12-19.47,33.28-23.44,1.02-3.14,2.02-6.29,2.94-9.44l5.27,1.54c-.62,2.13-1.28,4.26-1.95,6.39,7.54-1.26,13.09.07,16.15,3.93,2.87,3.62,4.28,8.29,4.14,13.49,4.85-2,9.82-3.65,14.71-5.28l1.74,5.21c-5.8,1.93-11.72,3.9-17.33,6.43Z" />
                  <path fill="currentColor"
                    d="M60.02,74.7s.03-.02.05-.02c8.45-4.63,15.09-12.51,18.5-21.72-1.42.83-2.82,1.72-4.16,2.67-6.8,4.82-12.04,11.77-14.38,19.07Z" />
                </g>
              </svg>
            </div>
          </a>
          <div class="menu-navbar-wrap">
            <div>
              <nav role="navigation" data-w-id="6311028f-aad4-8cc6-cf82-ce2ec10aa774" class="menu-navbar w-nav-menu">
                <div data-delay="250" data-hover="false" class="nav-link w-dropdown">
                  <a href="/" class="dropdown-navbar white-mobile w-dropdown-toggle" style="text-decoration:none;">
                    <div class="text-size-regular">Home</div>
                  </a>
                </div>

                <div data-delay="250" data-hover="false" class="nav-link w-dropdown">
                  <a href="/#services" class="dropdown-navbar white-mobile w-dropdown-toggle" style="text-decoration:none;">
                    <div class="text-size-regular">Services</div>
                  </a>
                </div>

                <div data-delay="250" data-hover="false" class="nav-link w-dropdown">
                  <a href="/#works" class="dropdown-navbar white-mobile w-dropdown-toggle" style="text-decoration:none;">
                    <div class="text-size-regular">Work</div>
                  </a>
                </div>

                <div data-delay="250" data-hover="false" class="nav-link w-dropdown">
                  <a href="/#contact" class="dropdown-navbar white-mobile w-dropdown-toggle" style="text-decoration:none;">
                    <div class="text-size-regular">Contact Us</div>
                  </a>
                </div>

                <div class="mobile-navbar-content">
                  <a href="/#works" class="link-block-navbar w-inline-block">
                    <div>Projects</div>
                  </a>
                  <a href="/#contact" class="link-block-navbar w-inline-block">
                    <div>Contact</div>
                  </a>
                  <a href="/#contact" class="navbar-button hide-mobile w-inline-block">
                    <div class="button-navbar-wrapper">
                      <div class="button-icon-navbar">
                        <img loading="lazy" src="/img/69002c5230201afdd240afef_Arrow Footer.svg" alt="Arrow" class="icon-navbar" />
                      </div>
                      <div class="button-navbar-text-color margin-right">
                        <div class="text-size-medium text-weight-medium">Get started</div>
                      </div>
                      <div class="button-icon-navbar absolute"></div>
                    </div>
                  </a>
                </div>
              </nav>
              <div class="menu-navbar-wrap">
                <div class="menu-navbar-button black-mobile w-nav-button">
                  <svg class="menu-icon-navbar black-mobile" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    xmlns="http://www.w3.org/2000/svg" style="display: block; width: 24px; height: 24px;">
                    <path class="line-top" d="M4 6H20" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                    <path class="line-middle" d="M4 12H20" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                    <path class="line-bottom" d="M4 18H20" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                  </svg>
                </div>
              </div>
            </div>
            <div class="right-navbar-content">
              <a href="/#works" class="link-block-navbar black w-inline-block">
                <div>Projects</div>
              </a>
              <a href="/#contact" class="link-block-navbar black w-inline-block">
                <div>Contact</div>
              </a>
              <a href="/#contact" class="navbar-button w-inline-block">
                <div class="button-navbar-wrapper">
                  <div class="button-icon-navbar white">
                    <img loading="lazy" src="/img/69002c5230201afdd240afef_Arrow Footer.svg" alt="Arrow" class="icon-navbar invet" />
                  </div>
                  <div class="button-navbar-text-color margin-right text-color-white">
                    <div class="text-size-medium">Get started</div>
                  </div>
                  <div class="button-icon-navbar absolute white"></div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="overlay-navbar"></div>
  </div>
</div>
