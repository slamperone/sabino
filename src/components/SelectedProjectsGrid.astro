---
// src/components/SelectedProjectsGrid.astro
import WorkCard from "./WorkCard.astro";
import { projects as allProjects, type Project } from "../data/projects";

interface Props {
  currentHref?: string;
  count?: number;
  wrapperClass?: string;
  projects?: Project[];
  cardId?: string;
  hoverId?: string;
  marqueeId?: string;
}

const {
  currentHref = Astro.url.pathname,
  count = 2,
  wrapperClass = "white-wrapper",
  projects = allProjects,
  cardId = "1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd1",
  hoverId = "1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd3",
  marqueeId = "1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd8",
} = Astro.props;

// Normalizar la URL actual para excluir el proyecto que se está visualizando
const normalizedCurrent = currentHref ? currentHref.replace(/\/$/, "") : "";

const availableProjects = projects.filter((p) => {
  const normalizedHref = p.href.replace(/\/$/, "");
  return normalizedHref !== normalizedCurrent;
});
---

<div class={wrapperClass}>
  <section>
    <div class="padding-global">
      <div class="works-cards-wrapper">
        <div class="work-cards-content">
          <div class="work-small-card-wrapper">
            <div class="card-collection-list-wrapper w-dyn-list">
              <div
                role="list"
                class="work-small-card-list w-dyn-items random-projects-container"
                data-count={count}
              >
                {
                  availableProjects.map((project) => (
                    <WorkCard
                      title={project.title}
                      href={project.href}
                      imgSrc={project.imgSrc}
                      cardId={cardId}
                      hoverId={hoverId}
                      marqueeId={marqueeId}
                    />
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var containers = document.querySelectorAll(".random-projects-container");
    containers.forEach(function (container) {
      var items = Array.prototype.slice.call(container.children);
      var count = parseInt(container.getAttribute("data-count") || "2", 10);
      if (items.length <= count) return;

      // Barajar aleatoriamente usando Fisher-Yates en el navegador
      for (var i = items.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var temp = items[i];
        items[i] = items[j];
        items[j] = temp;
      }

      var keep = items.slice(0, count);
      var remove = items.slice(count);

      remove.forEach(function (el) {
        el.remove();
      });
      keep.forEach(function (el) {
        container.appendChild(el);
      });
    });
  })();
</script>
