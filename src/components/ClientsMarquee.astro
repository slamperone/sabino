---
// src/components/ClientsMarquee.astro
interface Client {
  name: string;
  logo: string;
}

const baseClients: Client[] = [
  { name: "Everpure", logo: "/img/clients-everpure.svg" },
  { name: "BCDME", logo: "/img/clients-bcdme.svg" },
  { name: "SEICYM", logo: "/img/clients-seicym.svg" },
  { name: "SEREX", logo: "/img/clients-serex.svg" },
];

// Duplicamos los logos para garantizar una tira continua sin huecos vacíos
const clients = [...baseClients, ...baseClients];
---

<section class="clients-section" aria-label="Nuestros Clientes">
  <div class="padding-global">
    <div class="clients-marquee-wrapper">
      <div class="marquee-track">
        <!-- Grupo 1 -->
        <div class="marquee-group">
          {clients.map((client) => (
            <div class="client-item">
              <img
                src={client.logo}
                alt={client.name}
                loading="lazy"
                class="client-logo"
              />
            </div>
          ))}
        </div>

        <!-- Grupo 2 (Clon para loop continuo seamless) -->
        <div class="marquee-group" aria-hidden="true">
          {clients.map((client) => (
            <div class="client-item">
              <img
                src={client.logo}
                alt=""
                loading="lazy"
                class="client-logo"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .clients-section {
    position: relative;
    width: 100%;
    padding: 3rem 0;
    overflow: hidden;
  }

  .clients-marquee-wrapper {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 12%,
      rgba(0, 0, 0, 1) 88%,
      rgba(0, 0, 0, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 12%,
      rgba(0, 0, 0, 1) 88%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 3.5rem;
    padding-right: 3.5rem;
    animation: scroll-left 25s linear infinite;
  }

  /* Pausa suave en hover o touch */
  .clients-marquee-wrapper:hover .marquee-group,
  .clients-marquee-wrapper:active .marquee-group {
    animation-play-state: paused;
  }

  .client-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .client-logo {
    display: block;
    height: 150px;
    max-width: 350px;
    width: auto;
    object-fit: contain;
    opacity: 0.65;
    filter: brightness(0.9);
    transition: opacity 0.3s ease, filter 0.3s ease, transform 0.3s ease;
  }

  .client-item:hover .client-logo {
    opacity: 1;
    filter: brightness(1.2);
    transform: scale(1.05);
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  /* Ajustes responsive para Mobile y Tablets */
  @media screen and (max-width: 768px) {
    .clients-section {
      padding: 1.5rem 0;
    }

    .clients-marquee-wrapper {
      mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 1) 18%,
        rgba(0, 0, 0, 1) 82%,
        rgba(0, 0, 0, 0) 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 1) 18%,
        rgba(0, 0, 0, 1) 82%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    .marquee-group {
      gap: 2rem;
      padding-right: 2rem;
      animation-duration: 18s;
    }

    .client-logo {
      height: 80px;
      max-width: 120px;
      opacity: 0.75;
    }
  }
</style>
