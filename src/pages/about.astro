---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import BottomNavbar from "../components/BottomNavbar.astro";
import DisplayTitle from "../components/DisplayTitle.astro";
---

<BaseLayout
  title="About — Puenter Agency"
  description="Puenter is the design and illustration studio of Daniel Puente Ramírez."
  wfPage="69002c5230201afdd240ad49"
  navTheme="white"
>
  <!-- Menú flotante (el mismo del home) -->
  <BottomNavbar />

  <section class="about">
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="about-grid">

          <!-- Izquierda: título + texto -->
          <div class="about-text">
            <div class="about-title">
              <DisplayTitle as="h1">
              Independent <br />
              by design.
            </DisplayTitle>
            </div>
            <div class="about-body">
              <p>PUENTER is an independent design studio founded and led by Daniel&nbsp;Puente, 
              a graphic designer and art director with over 10 years of&nbsp;experience.</p>
              <p>We work with brands and creative teams to turn ideas into clear, 
              considered design across branding, digital experiences, and motion graphics. 
              From defining a visual identity to developing creative for a larger campaign, 
              we bring the same focus to every project: understand the problem, find the right idea, 
              and make the design do its job.</p>
              <p>Daniel’s experience spans technology, education, and hospitality, 
              with years of collaboration with clients and creative teams in Mexico and abroad. 
              His approach combines art direction, strategic thinking, and hands-on design, 
              with an eye for both the bigger picture and the details that bring it all together.</p>
              <p>The aim is simple: make things clear, make them work, and make them worth looking at.</p>
              <p>Have a project in mind? Let’s talk.</p>
            </div>
          </div>

          <!-- Derecha: foto (mismo efecto de entrada que las páginas de works) -->
          <div class="about-photo">
            <div
              data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f"
              style="opacity:0"
              class="blog-image-wrapper"
            >
              <img
                style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
                alt="Daniel Puente Ramírez"
                src="/img/about.png"
                loading="lazy"
                class="image"
              />
              <div style="height:100%" class="mask-frame"></div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: 10rem;
    padding-bottom: 10rem; /* espacio para que el menú flotante no tape el texto */
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .about-title {
    margin-top: 0;
    margin-bottom: 2.5rem;
  }
  .about-title :global(.display-title-wrap) {
    justify-content: flex-start;
  }
  .about-title :global(.display-title-text) {
    text-align: left;
  }
  .about-body p {
    max-width: 34rem;
    margin-bottom: 1.25rem;
  }
  .about-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .about-photo .blog-image-wrapper {
    height: 100%;
    margin: 0;
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Celular: una columna, la foto queda debajo del texto */
  @media (max-width: 767px) {
    .about {
      padding-top: 7rem;
      padding-bottom: 8rem;
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>