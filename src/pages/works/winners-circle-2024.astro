---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNavbar from "../../components/BottomNavbar.astro";
import SelectedProjectsGrid from "../../components/SelectedProjectsGrid.astro";
import LastCta from "../../components/LastCta.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";

const { title = "Winners Circle 2024" } = Astro.props;
---

<BaseLayout
  title="Winners Circle 2024"
  description="Goodyear, Cooper Tires & Mastercraft Winners Circle 2024 event branding at Meliá Punta Cana."
  ogImage="/img/home-work-8.jpg"
  wfPage="69002c5230201afdd240ad49"
  navTheme="white"
>
  <BottomNavbar />

  <!-- Project Heading -->
  <section>
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="margin-top-15vh">
          <div class="hero-content-wrapper">
            <div class="hero-heading-content max-width-100">
              {
                title && (
                  <div class="clients-header margin-bottom-4vh margin-top-1vh">
                    <DisplayTitle text={title} />
                  </div>
                )
              }
              <div class="rich-text align-center w-richtext">
                <h4>
                  <span class="text-weight-bold">End Client:</span> Goodyear |
                  <span class="text-weight-bold">Partner:</span> BCD Meetings & Events
                  |
                  <span class="text-weight-bold">Services:</span> Art Direction, Event
                  Branding
                </h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Hero Image -->
  <section>
    <div
      data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f"
      style="opacity:0"
      class="blog-image-wrapper"
    >
      <img
        style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
        alt="Goodyear Winners Circle 2024"
        src="/img/works/winners-circle-2024/work_8-1.jpg"
        loading="lazy"
        class="image"
      />
      <div style="height:100%" class="mask-frame"></div>
    </div>
  </section>

  <!-- Project Case Study Content -->
  <section>
    <div class="w-layout-blockcontainer container w-container">
      <div class="works-template">
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Goodyear Winner’s Circle is an incentive program created to
              recognize top-performing tire dealers with a destination
              experience shared with their guests. For the 2024 edition,
              approximately 850 attendees traveled to Punta Cana across two
              consecutive waves, combining recognition, leisure, and hosted
              activities in a Caribbean setting.
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Winners Circle Program of Events"
            loading="lazy"
            src="/img/works/winners-circle-2024/work_8-2.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              The identity takes its cue from the Winner’s Circle name, using
              layered circular forms as the main graphic device throughout the
              event. Their repetition creates a simple, recognizable system that
              can shift in scale and composition while keeping every piece
              connected.
            </h3>
          </div>
        </div>

        <!-- Vertical paired images -->
        <div class="work-template-images">
          <img
            alt="Welcome to Punta Cana Gifting Kit"
            loading="lazy"
            src="/img/works/winners-circle-2024/work_8-3.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-template-images">
          <img
            alt="Winners Circle Attendee Credentials"
            loading="lazy"
            src="/img/works/winners-circle-2024/work_8-4.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              A palette of deep Goodyear blues with brighter blue and green
              accents brings in the color and relaxed character of Punta Cana
              without turning the event into a generic tropical theme. The
              system was applied across pre-trip communications, program
              materials, luggage pieces, welcome gifts, credentials, signage,
              and other on-site touchpoints, helping the experience feel
              consistent from the build-up to arrival.
            </h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate CTA Section -->
  <section>
    <div class="white-wrapper">
      <div class="padding-global">
        <div class="w-layout-blockcontainer container medium w-container">
          <div class="cta-component">
            <div class="cta-wrapper">
              <div class="marquee-tag">
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
              </div>
              <div class="cta">
                <div class="text-size-xdisplay line-height-122 about-style">
                  Strategic thinking. Thoughtful execution. Designed to connect,
                  engage, and move brands forward.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Grid -->
  <SelectedProjectsGrid />

  <!-- Last CTA -->
  <LastCta />
</BaseLayout>
