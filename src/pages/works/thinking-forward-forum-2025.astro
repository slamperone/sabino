---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNavbar from "../../components/BottomNavbar.astro";
import SelectedProjectsGrid from "../../components/SelectedProjectsGrid.astro";
import LastCta from "../../components/LastCta.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";

const { title = "Thinking Forward Forum 2025" } = Astro.props;
---

<BaseLayout
  title="Thinking Forward Forum 2025"
  description="Event branding, visual identity, and environmental graphics for BCD Meetings & Events."
  ogImage="/img/home-work-6.jpg"
  wfPage="69002c5230201afdd240ad49"
  navTheme="white"
>
  <BottomNavbar />

  <!-- Project Heading -->
  <section>
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="margin-top-15vh">
          <div class="hero-content-wrapper">
            <div class="hero-heading-content max-width-100">
              {
                title && (
                  <div class="clients-header margin-bottom-4vh margin-top-1vh">
                    <DisplayTitle text={title} />
                  </div>
                )
              }
              <div class="rich-text align-center w-richtext">
                <h4>
                  <span class="text-weight-bold">End Client:</span> BCD Meetings &
                  Events |
                  <span class="text-weight-bold">Services:</span> Art Direction, Event
                  Branding, Environmental Branding
                </h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Hero Image -->
  <section>
    <div
      data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f"
      style="opacity:0"
      class="blog-image-wrapper"
    >
      <img
        style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
        alt="Thinking Forward Forum 2025"
        src="/img/works/thinking-forward-forum-2025/work_6-1.jpg"
        loading="lazy"
        class="image"
      />
      <div style="height:100%" class="mask-frame"></div>
    </div>
  </section>

  <!-- Project Case Study Content -->
  <section>
    <div class="w-layout-blockcontainer container w-container">
      <div class="works-template">
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Thinking Forward Forum brought together BCD Meetings & Events
              leaders from across North America to discuss the future of the
              business, share ideas, and strengthen collaboration across teams.
              For the 2025 edition in Orlando, the event built on BCD’s existing
              Thinking Forward initiative and its annual theme, “Expand.
              Embrace. Excel.”
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Thinking Forward Forum Event Graphics"
            loading="lazy"
            src="/img/works/thinking-forward-forum-2025/work_6-2.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Starting with the existing Thinking Forward lockup, emblem, and
              color palette, the event identity expanded the system into
              something specific to the Forum. The added “Forum” designation
              gave the event its own voice, while forward-pointing forms, angled
              compositions, and repeated linework reinforced the idea of
              progress already embedded in the parent identity.
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Sponsorship and Stage Collateral"
            loading="lazy"
            src="/img/works/thinking-forward-forum-2025/work_6-3.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Warm gradient tones bring more energy to BCD’s deep blue, while
              cropped views of Orlando connect the system to its setting without
              turning the destination into the main idea. The result is a
              flexible event system designed to carry from registration and
              signage to credentials, environmental graphics, and other on-site
              applications.
            </h3>
          </div>
        </div>

        <!-- Vertical paired images -->
        <div class="work-template-images vertical">
          <img
            alt="Thinking Forward Forum Attendee Badge"
            loading="lazy"
            src="/img/works/thinking-forward-forum-2025/work_6-7.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Sponsorship and Stage Collateral"
            loading="lazy"
            src="/img/works/thinking-forward-forum-2025/work_6-4.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Sponsorship and Stage Collateral"
            loading="lazy"
            src="/img/works/thinking-forward-forum-2025/work_6-5.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Sponsorship and Stage Collateral"
            loading="lazy"
            src="/img/works/thinking-forward-forum-2025/work_6-6.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate CTA Section -->
  <section>
    <div class="white-wrapper">
      <div class="padding-global">
        <div class="w-layout-blockcontainer container medium w-container">
          <div class="cta-component">
            <div class="cta-wrapper">
              <div class="marquee-tag">
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
              </div>
              <div class="cta">
                <div class="text-size-xdisplay line-height-122 about-style">
                  Strategic thinking. Thoughtful execution. Designed to connect,
                  engage, and move brands forward.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Grid -->
  <SelectedProjectsGrid />

  <!-- Last CTA -->
  <LastCta />
</BaseLayout>
