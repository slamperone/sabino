---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNavbar from "../../components/BottomNavbar.astro";
import SelectedProjectsGrid from "../../components/SelectedProjectsGrid.astro";
import LastCta from "../../components/LastCta.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";

const { title = "Launch Engagement Reports FY21 & FY23" } = Astro.props;
---

<BaseLayout
  title="Launch Engagement Reports FY21 & FY23"
  description="Engagement report design for a partner launch program, across a brand refresh."
  ogImage="/img/home-work-14.jpg"
  wfPage="69002c5230201afdd240ad49"
  navTheme="white"
>
  <BottomNavbar />

  <!-- Project Heading -->
  <section>
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="margin-top-15vh">
          <div class="hero-content-wrapper">
            <div class="hero-heading-content max-width-100">
              {
                title && (
                  <div class="clients-header margin-bottom-4vh margin-top-1vh">
                    <DisplayTitle text={title} />
                  </div>
                )
              }
              <div class="rich-text align-center w-richtext">
                <h4>
                  <span class="text-weight-bold">End Client:</span> Confidential |
                  <span class="text-weight-bold">Services:</span> Data Visualization, 
                  Infographic Design, Illustration
                </h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Hero Image -->
  <section>
    <div
      data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f"
      style="opacity:0"
      class="blog-image-wrapper"
    >
      <img
        style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
        alt="Launch Engagement Reports FY21 & FY23"
        src="/img/works/launch-engagement-reports/work_14-1.jpg"
        loading="lazy"
        class="image"
      />
      <div style="height:100%" class="mask-frame"></div>
    </div>
  </section>

  <!-- Project Case Study Content -->
  <section>
    <div class="w-layout-blockcontainer container w-container">
      <div class="works-template">
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              A one-page engagement report for a recurring 
              partner-facing product launch experience, delivered on demand. 
              The report brings together reach, content consumption, 
              and business impact for readers with little time and no 
              prior knowledge of the metrics.
            </h3>
          </div>
        </div>

        <div class="work-template-images vertical">
          <img
            alt="FY21 engagement report"
            loading="lazy"
            src="/img/works/launch-engagement-reports/work_14-2.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-template-images vertical right">
          <img
            alt="FY23 engagement report"
            loading="lazy"
            src="/img/works/launch-engagement-reports/work_14-3.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
          </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              The format was built to read in a deliberate order: 
              headline engagement metrics, business impact, 
              top-performing content, and audience reach. That structure became 
              the constant of the program, carried into the following edition, 
              with data sources listed at the end of the page.
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Detail comparison of both editions"
            loading="lazy"
            src="/img/works/launch-engagement-reports/work_14-4.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h4>
              All illustrations are original work. 
              Client details, names, and figures have been 
              modified for confidentiality.
            </h4>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate CTA Section -->
  <section>
    <div class="white-wrapper">
      <div class="padding-global">
        <div class="w-layout-blockcontainer container medium w-container">
          <div class="cta-component">
            <div class="cta-wrapper">
              <div class="marquee-tag">
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
              </div>
              <div class="cta">
                <div class="text-size-xdisplay line-height-122 about-style">
                  Strategic thinking. Thoughtful execution. Designed to connect,
                  engage, and move brands forward.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Grid -->
  <SelectedProjectsGrid />

  <!-- Last CTA -->
  <LastCta />
</BaseLayout>
