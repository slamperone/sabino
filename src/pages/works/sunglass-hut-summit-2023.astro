---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNavbar from "../../components/BottomNavbar.astro";
import SelectedProjectsGrid from "../../components/SelectedProjectsGrid.astro";
import LastCta from "../../components/LastCta.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";

const { title = "Sunglass Hut Summit 2023" } = Astro.props;
---

<BaseLayout
  title="Sunglass Hut Summit 2023"
  description="An iconic project meticulously curated by us."
  ogImage="/img/steeeezy/steeeezy-hero.jpg"
  wfPage="69002c5230201afdd240ad49"
  navTheme="white"
>
  <BottomNavbar />

  <!-- Project Heading -->
  <section>
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="margin-top-15vh">
          <div class="hero-content-wrapper">
            <div class="hero-heading-content max-width-100">
              {
                title && (
                  <div class="clients-header margin-bottom-10vh margin-top-10vh">
                    <DisplayTitle text={title} />
                  </div>
                )
              }
              <div class="rich-text align-center w-richtext">
                <h4>
                  <span class="text-weight-bold">End Client:</span> Sunglass Hut |
                  <span class="text-weight-bold">Partner:</span> BCD Meetings & Events
                  |
                  <span class="text-weight-bold">Services:</span> Art Direction, Event
                  Branding
                </h4>

                <h4>
                  Concept developed and delivered for the event. Not ultimately
                  produced.
                </h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Hero Image -->
  <section>
    <div
      data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f"
      style="opacity:0"
      class="blog-image-wrapper"
    >
      <img
        style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
        alt="Sunglass Hut Summit 2023"
        src="/img/works/sunglass-hut-summit-2023/work_4-1.png"
        loading="lazy"
        class="image"
      />
      <div style="height:100%" class="mask-frame"></div>
    </div>
  </section>

  <!-- Project Case Study Content -->
  <section>
    <div class="w-layout-blockcontainer container w-container">
      <div class="works-template">
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Developed for Sunglass Hut Summit 2023, the proposed identity
              translated the theme “Envision. Empower. Ignite.” into a system
              built around energy, individuality, and self-expression. The goal
              was to create a contemporary look that felt connected to the brand
              while giving the event its own personality.
            </h3>
          </div>
        </div>
        <div class="work-template-images margin-bottom">
          <img
            alt="platinum-circle-2024"
            loading="lazy"
            src="/img/works/sunglass-hut-summit-2023/work_4-3.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>Recognition, rooted in place.</h3>
            <h3>
              The concept reinterprets Sunglass Hut’s white circle as a source
              of light and energy. Fields of orange dots radiate from different
              points, creating movement throughout the identity and turning a
              simple brand element into the main graphic device.
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Platinum Circle 2024"
            loading="lazy"
            src="/img/works/sunglass-hut-summit-2023/work_4-4.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Black, white, and orange keep the connection to Sunglass Hut
              immediate, while the mix of serif and sans-serif typography adds a
              more editorial character. The system was applied across digital
              graphics, credentials, menus, tabletop pieces, and environmental
              signage.
            </h3>
          </div>
        </div>
        <!-- guardar por que lo vamos a usar en los demas proyectos-->
        <div class="work-template-images vertical">
          <img
            alt="Sunglass Hut Summit 2023"
            loading="lazy"
            src="/img/works/sunglass-hut-summit-2023/work_4-2.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-template-images vertical right">
          <img
            alt="Sunglass Hut Summit 2023"
            loading="lazy"
            src="/img/works/sunglass-hut-summit-2023/work_4-5.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate CTA Section -->
  <section>
    <div class="white-wrapper">
      <div class="padding-global">
        <div class="w-layout-blockcontainer container medium w-container">
          <div class="cta-component">
            <div class="cta-wrapper">
              <div class="marquee-tag">
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
              </div>
              <div class="cta">
                <div class="text-size-xdisplay line-height-122 about-style">
                  Strategic thinking. Thoughtful execution. Designed to connect,
                  engage, and move brands forward.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Grid -->
  <SelectedProjectsGrid />

  <!-- Last CTA -->
  <LastCta />
</BaseLayout>
