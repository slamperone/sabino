---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNavbar from "../../components/BottomNavbar.astro";
import SelectedProjectsGrid from "../../components/SelectedProjectsGrid.astro";
import LastCta from "../../components/LastCta.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";

const { title = "Global Partner Summit 2026" } = Astro.props;
---

<BaseLayout
  title="Global Partner Summit 2026"
  description="An iconic project meticulously curated by us."
  ogImage="/img/steeeezy/steeeezy-hero.jpg"
  wfPage="69002c5230201afdd240ad49"
  navTheme="white"
>
  <BottomNavbar />

  <!-- Project Heading -->
  <section>
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="margin-top-15vh">
          <div class="hero-content-wrapper">
            <div class="hero-heading-content max-width-100">
              {
                title && (
                  <div class="clients-header margin-bottom-10vh margin-top-10vh">
                    <DisplayTitle text={title} />
                  </div>
                )
              }
              <div class="rich-text align-center w-richtext">
                <h4>
                  <span class="text-weight-bold">End client:</span> Fire TV |
                  <span class="text-weight-bold">Partner:</span> BCD Meetings & Events
                  |
                  <span class="text-weight-bold">Services:</span> Art Direction, Event
                  Branding
                </h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Hero Image -->
  <section>
    <div
      data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f"
      style="opacity:0"
      class="blog-image-wrapper"
    >
      <img
        style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
        alt="Steeeezy"
        src="/img/works/global-partner-summit-2026/work_1-1.jpg"
        loading="lazy"
        class="image"
      />
      <div style="height:100%" class="mask-frame"></div>
    </div>
  </section>

  <!-- Project Case Study Content -->
  <section>
    <div class="w-layout-blockcontainer container w-container">
      <div class="works-template">
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Fire TV’s inaugural Global Partner Summit brought together key
              partners from around the world in Singapore. The event called for
              a visual identity that balanced the brand’s technology-driven
              character with the city’s lush, tropical environment, creating an
              experience that felt sophisticated, contemporary, and distinctly
              connected to&nbsp;its&nbsp;setting.
            </h3>
          </div>
        </div>
        <div class="work-template-images margin-bottom">
          <img
            alt="Steeeezy Project 01"
            loading="lazy"
            src="/img/works/global-partner-summit-2026/work_1-2.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>Where technology meets the Garden City.</h3>
            <h3>
              Singapore is known as a city where nature and urban life coexist,
              making that contrast the starting point for the identity. Inspired
              by the city’s “Garden City” character, the visual language brings
              an organic sensibility into Fire TV’s technology&#8209;driven
              world, creating a system that feels rooted in its destination
              without losing the energy of the brand.
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Steeeezy Project 02"
            loading="lazy"
            src="/img/works/global-partner-summit-2026/work_1-3.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Layered botanical forms grow, overlap, and shift across
              applications, moving from subtle graphic accents to immersive
              environmental elements. Fire TV’s signature orange cuts through a
              natural green palette, connecting the tropical visual language
              back to the brand and giving the system its energy.
            </h3>
          </div>
        </div>
        <!-- guardar por que lo vamos a usar en los demas proyectos
        <div class="work-template-images vertical">
          <img
            alt="Steeeezy Project 04"
            loading="lazy"
            src="/img/works/global-partner-summit-2026/work_1-4.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-template-images vertical right">
          <img
            alt="Steeeezy Project 05"
            loading="lazy"
            src="/img/steeeezy/project-img-05.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h2>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
              eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
              enim ad minim veniam, quis <em
                >nostrud exercitation ullamco laboris nisi ut aliquip.</em
              > Duis aute irure dolor in reprehenderit in voluptate velit esse cillum
              dolore eu fugiat nulla pariatur.
            </h2>
          </div>
        </div>
         -->
        <div class="work-template-images margin-bottom">
          <img
            alt="Steeeezy Project 06"
            loading="lazy"
            src="/img/works/global-partner-summit-2026/work_1-4.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate CTA Section -->
  <section>
    <div class="white-wrapper">
      <div class="padding-global">
        <div class="w-layout-blockcontainer container medium w-container">
          <div class="cta-component">
            <div class="cta-wrapper">
              <div class="marquee-tag">
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
              </div>
              <div class="cta">
                <div class="text-size-xdisplay line-height-122 about-style">
                  Strategic thinking. Thoughtful execution. Designed to connect,
                  engage, and move brands forward.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Grid -->
  <SelectedProjectsGrid />

  <!-- Last CTA -->
  <LastCta />
</BaseLayout>
