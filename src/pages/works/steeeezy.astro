---
// src/pages/works/steeeezy.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BottomNavbar from '../../components/BottomNavbar.astro';
import WorkCard from '../../components/WorkCard.astro';
import LastCta from '../../components/LastCta.astro';
---

<BaseLayout
  title="Aries - Steeeezy — Puenter Agency"
  description="An iconic project meticulously curated by us."
  ogImage="/img/steeeezy/steeeezy-hero.jpg"
  wfPage="69002c5230201afdd240ad49"
>
  <BottomNavbar />

  <!-- Project Heading -->
  <section>
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="margin-top-15vh">
          <div class="hero-content-wrapper">
            <div class="hero-heading-content">
              <div class="heading-4-vw text-weight-medium">Steeeezy</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Hero Image -->
  <section>
    <div data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f" style="opacity:0" class="blog-image-wrapper">
      <img
        style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
        alt="Steeeezy"
        src="/img/steeeezy/steeeezy-hero.jpg"
        loading="lazy"
        class="image"
      />
      <div style="height:100%" class="mask-frame"></div>
    </div>
  </section>

  <!-- Project Case Study Content -->
  <section>
    <div class="w-layout-blockcontainer container w-container">
      <div class="works-template">
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h2>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis <em>nostrud exercitation ullamco laboris nisi ut aliquip.</em> Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</h2>
          </div>
        </div>
        <div class="work-template-images">
          <img alt="Steeeezy Project 01" loading="lazy" src="/img/steeeezy/project-img-01.jpg" class="image" />
          <div class="mask-frame"></div>
        </div>
        <div class="work-template-images margin-bottom">
          <img alt="Steeeezy Project 02" loading="lazy" src="/img/steeeezy/project-img-02.jpg" class="image" />
          <div class="mask-frame"></div>
        </div>
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h2>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis <em>nostrud exercitation ullamco laboris nisi ut aliquip.</em> Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</h2>
          </div>
        </div>
        <div class="work-template-images margin-bottom">
          <img alt="Steeeezy Project 03" loading="lazy" src="/img/steeeezy/project-img-03.jpg" class="image" />
          <div class="mask-frame"></div>
        </div>
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h2>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis <em>nostrud exercitation ullamco laboris nisi ut aliquip.</em> Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</h2>
          </div>
        </div>
        <div class="work-template-images vertical">
          <img alt="Steeeezy Project 04" loading="lazy" src="/img/steeeezy/project-img-04.jpg" class="image" />
          <div class="mask-frame"></div>
        </div>
        <div class="work-template-images vertical right">
          <img alt="Steeeezy Project 05" loading="lazy" src="/img/steeeezy/project-img-05.jpg" class="image" />
          <div class="mask-frame"></div>
        </div>
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h2>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis <em>nostrud exercitation ullamco laboris nisi ut aliquip.</em> Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</h2>
          </div>
        </div>
        <div class="work-template-images">
          <img alt="Steeeezy Project 06" loading="lazy" src="/img/steeeezy/project-img-06.jpg" class="image" />
          <div class="mask-frame"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate CTA Section -->
  <section>
    <div class="white-wrapper">
      <div class="padding-global">
        <div class="w-layout-blockcontainer container medium w-container">
          <div class="cta-component">
            <div class="cta-wrapper">
              <div class="marquee-tag">
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
              </div>
              <div class="cta">
                <div class="text-size-xdisplay line-height-122 about-style">
                  Unlock new opportunities and drive innovation with our expert solutions. Whether you're looking to enhance your digital presence
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Grid -->
  <div class="white-wrapper">
    <section>
      <div class="padding-global">
        <div class="works-cards-wrapper">
          <div class="work-cards-content">
            <div class="work-small-card-wrapper">
              <div class="card-collection-list-wrapper w-dyn-list">
                <div role="list" class="work-small-card-list w-dyn-items">
                  <WorkCard
                    title="Mercury"
                    href="/works/mercury"
                    imgSrc="/img/home-work-1.jpg"
                    cardId="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd1"
                    hoverId="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd3"
                    marqueeId="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd8"
                  />
                  <WorkCard
                    title="Straps"
                    href="/works/straps"
                    imgSrc="/img/home-work-2.jpg"
                    cardId="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd1"
                    hoverId="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd3"
                    marqueeId="1f31c30e-2bd5-8c2d-ee1f-7bbb620cabd8"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Last CTA -->
  <LastCta />
</BaseLayout>
