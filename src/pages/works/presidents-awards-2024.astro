---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomNavbar from "../../components/BottomNavbar.astro";
import SelectedProjectsGrid from "../../components/SelectedProjectsGrid.astro";
import LastCta from "../../components/LastCta.astro";
import DisplayTitle from "../../components/DisplayTitle.astro";

const { title = "President's Awards 2024" } = Astro.props;
---

<BaseLayout
  title="President's Awards 2024"
  description="EMD Serono President's Awards 2024 event branding and experience design at St. Regis Aruba."
  ogImage="/img/home-work-7.jpg"
  wfPage="69002c5230201afdd240ad49"
  navTheme="white"
>
  <BottomNavbar />

  <!-- Project Heading -->
  <section>
    <div class="padding-global">
      <div class="w-layout-blockcontainer container w-container">
        <div class="margin-top-15vh">
          <div class="hero-content-wrapper">
            <div class="hero-heading-content max-width-100">
              {
                title && (
                  <div class="clients-header margin-bottom-10vh margin-top-10vh">
                    <DisplayTitle text={title} />
                  </div>
                )
              }
              <div class="rich-text align-center w-richtext">
                <h4>
                  <span class="text-weight-bold">End Client:</span> EMD Serono |
                  <span class="text-weight-bold">Partner:</span> BCD Meetings & Events
                  |
                  <span class="text-weight-bold">Services:</span> Graphic Design,
                  Event Branding
                </h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Hero Image -->
  <section>
    <div
      data-w-id="0b4fc445-652d-5de3-a1c2-e45bf38fcd4f"
      style="opacity:0"
      class="blog-image-wrapper"
    >
      <img
        style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1);transform:translate3d(0, 0, 0) scale3d(1.2, 1.2, 1)"
        alt="EMD Serono President's Awards 2024"
        src="/img/works/presidents-awards-2024/work_7-1.jpg"
        loading="lazy"
        class="image"
      />
      <div style="height:100%" class="mask-frame"></div>
    </div>
  </section>

  <!-- Project Case Study Content -->
  <section>
    <div class="w-layout-blockcontainer container w-container">
      <div class="works-template">
        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              EMD Serono’s President’s Award recognized the company’s top sales
              performers with a destination experience at The St. Regis Aruba
              Resort. Winners, guests, and executive leadership came together
              for a program that balanced recognition, planned activities, and
              time to enjoy the island.
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="President's Awards Recognition Collateral"
            loading="lazy"
            src="/img/works/presidents-awards-2024/work_7-2.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              Working from an established art direction centered on Aruba’s
              color, sunlight, and natural setting, the identity was developed
              into a full event system. Layered geometric forms frame
              destination photography and create a recurring structure across
              the materials, while deep navy, turquoise, white, and gold balance
              the relaxed Caribbean setting with the sense of recognition
              expected from an awards program.
            </h3>
          </div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="Event Program and Keynote Graphics"
            loading="lazy"
            src="/img/works/presidents-awards-2024/work_7-3.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-content">
          <div class="rich-text align-center w-richtext">
            <h3>
              The system was carried across pre-event communications, travel
              materials, program books, gifting, menus, signage, and other
              on-site pieces, keeping the experience consistent from arrival
              through the final event touchpoints.
            </h3>
          </div>
        </div>

        <!-- Vertical paired images -->
        <div class="work-template-images vertical">
          <img
            alt="Aruba Breakout Session Signage"
            loading="lazy"
            src="/img/works/presidents-awards-2024/work_7-4.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
        <div class="work-template-images vertical right">
          <img
            alt="Bon Bini Aruba Gifting Collateral"
            loading="lazy"
            src="/img/works/presidents-awards-2024/work_7-5.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>

        <div class="work-template-images margin-bottom">
          <img
            alt="President's Awards Recognition Collateral"
            loading="lazy"
            src="/img/works/presidents-awards-2024/work_7-6.jpg"
            class="image"
          />
          <div class="mask-frame"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intermediate CTA Section -->
  <section>
    <div class="white-wrapper">
      <div class="padding-global">
        <div class="w-layout-blockcontainer container medium w-container">
          <div class="cta-component">
            <div class="cta-wrapper">
              <div class="marquee-tag">
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
                <div class="marquee-tag-wrapper">
                  <div class="text-size-small caps">selected projects</div>
                  <div class="elipse"></div>
                </div>
              </div>
              <div class="cta">
                <div class="text-size-xdisplay line-height-122 about-style">
                  Strategic thinking. Thoughtful execution. Designed to connect,
                  engage, and move brands forward.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Grid -->
  <SelectedProjectsGrid />

  <!-- Last CTA -->
  <LastCta />
</BaseLayout>
